# =====================================================================
# IT Navigator - IBM watsonx Orchestrate Environment Configuration
# =====================================================================
# Copy this file to .env and fill in your personal IBM Cloud API Key.
# DO NOT commit your .env file to GitHub.

# Your IBM Cloud API Key (from Manage -> Access (IAM) -> API keys)
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here

# Watson Orchestrate API Key (defaults to IBM_CLOUD_API_KEY if omitted)
WATSON_ORCHESTRATE_API_KEY=your_watson_orchestrate_api_key_here

# Watson Orchestrate Instance URL
WATSON_ORCHESTRATE_URL=https://api.eu-gb.watson-orchestrate.cloud.ibm.com/instances/44e00af6-23d2-4ec1-b06f-506d97dd2083
